# ============================================
# Proviso — Terms. Spend. Proof.
# Environment Configuration
# ============================================

# --- LLM Provider ---
# Options: "gemini", "openai", or "ollama"
# Gemini is the recommended demonstration provider. Free-tier data may be used
# by Google to improve its products, so keep this prototype's synthetic data only.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# OpenAI (only if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Ollama (if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Database ---
# Leave these unset for the default local SQLite ledger at
# data/enterprise_ledger.db. Docker Compose supplies its own local PostgreSQL
# connections when that optional deployment profile is used.
# DATABASE_URL=
# DATABASE_URL_SYNC=
# DATABASE_READONLY_URL=

# --- Vector Database (ChromaDB) ---
CHROMA_HOST=localhost
CHROMA_PORT=8100
CHROMA_COLLECTION=vendor_contracts
USE_LOCAL_CHROMA=true
RETRIEVAL_MIN_RELEVANCE_SCORE=0.40

# --- PostgreSQL Passwords (Docker Compose only) ---
# Generate a secret: python -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD=
POSTGRES_READONLY_PASSWORD=

# --- JWT Authentication ---
# Generate a secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Observability (LangSmith) ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=proviso

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=30

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Frontend ---
BACKEND_API_URL=http://localhost:8000
